### Testing Streams with Concurrency Limit

Source: https://github.com/iptv-org/iptv/blob/master/_autodocs/api-reference/stream-tester.md

Use StreamTester with async 'eachLimit' to test multiple streams concurrently. This example demonstrates setting a concurrency limit and tracking passed/failed counts.

```typescript
import { StreamTester } from './core/streamTester'
import { eachLimit } from 'async'

const tester = new StreamTester({ options })
let passedCount = 0
let failedCount = 0

const testResults = new Collection<Stream>()

// Test streams in parallel with concurrency limit
await new Promise((resolve, reject) => {
  eachLimit(
    streams.all(),
    4, // Test 4 streams concurrently
    async (stream: Stream) => {
      const result = await tester.test(stream)
      
      if (result.status.ok) {
        passedCount++
      } else {
        failedCount++
        stream.statusCode = result.status.code
      }
    },
    (err) => {
      if (err) reject(err)
      else resolve(undefined)
    }
  )
})

console.log(`Passed: ${passedCount}, Failed: ${failedCount}`)
```

