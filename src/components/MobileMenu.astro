---
const { pathname } = Astro.url;
---

<!-- Mobile Navigation Overlay Drawer -->
<div class="mobile-nav-overlay" id="mobileNavOverlay">
  <div class="mobile-nav-drawer">
    <div class="mobile-nav-header">
      <a href="/" class="logo">
        <img 
          src="/assets/logo.webp" 
          alt="GoPlay Logo" 
          class="logo-img" 
          width="32" 
          height="32" 
          loading="eager" 
          decoding="async" 
        />
        <div class="logo-text-group">
          <span class="logo-text">GoPlay</span>
          <span class="logo-subtitle">Live TV & IPTV</span>
        </div>
      </a>
      <button class="btn-close-nav" id="closeNavBtn" title="Close Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="mobile-nav-menu">
      <a href="/" class={`mobile-nav-link ${pathname === "/" || pathname.startsWith("/watch") ? "active" : ""}`}>
        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="15" rx="2.18" ry="2.18"></rect>
          <line x1="7" y1="22" x2="17" y2="22"></line>
          <line x1="12" y1="17" x2="12" y2="22"></line>
        </svg>
        <span>Channels</span>
      </a>
      <a href="/upcoming" class={`mobile-nav-link ${pathname === "/upcoming" ? "active" : ""}`}>
        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Schedule</span>
      </a>
      <a href="/android" class="mobile-nav-link apk-mobile-link">
        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3a.495.495 0 0 0 0-.7.495.495 0 0 0-.7 0l-1.47 1.47C13.78 1.23 12.91 1 12 1c-.91 0-1.78.23-2.66.63L7.87.16a.495.495 0 0 0-.7 0 .495.495 0 0 0 0 .7l1.3 1.3C6.44 3.4 5.25 5.51 5.03 8h13.94c-.22-2.49-1.41-4.6-3.44-5.84zM9 5.5c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm6 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
        </svg>
        <span>Android App</span>
      </a>
    </nav>
    <div class="mobile-nav-footer">
      <p>© 2026 GoPlay. All rights reserved.</p>
    </div>
  </div>
</div>
