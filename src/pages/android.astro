<script>
  const leagues = [
    "FIFA World Cup 2026", "Premier League", "La Liga", "Serie A", 
    "Bundesliga", "Champions League", "Copa América", "IPL Cricket", 
    "T20 World Cup", "US Open", "Wimbledon", "Formula 1"
  ];
  const track = document.getElementById('marquee');
  const build = () => leagues.map(l => `<span><i></i>${l}</span>`).join('');
  if (track) track.innerHTML = build() + build();

  // reveal on scroll
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ 
      if(e.isIntersecting){ 
        e.target.classList.add('in'); 
        io.unobserve(e.target); 
      } 
    });
  }, {threshold:0.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // Interactive phone slider & showcase sync logic
  const heroStackContainer = document.getElementById('hero-stack');
  const heroStreamImg = document.getElementById('hero-stream-img');
  const showcaseContainer = document.getElementById('showcase-stack');
  const checklistItems = document.querySelectorAll('.check-item');
  const STREAM_IMG_SRC = "https://pub-0440e8e4ec654c10b2471b3b64aa4265.r2.dev/App%20Screen/Goplay%20Screen%203.webp";
  
  const STACK_STATES = ['state-1', 'state-2', 'state-0'];
  const STATE_CLASSES = ['state-0', 'state-1', 'state-2'];
  let currentIndex = 0;
  let autoSlideInterval = null;

  const applyStackState = (el, index) => {
    if (!el) return;
    el.classList.remove(...STATE_CLASSES);
    el.classList.add(STACK_STATES[index]);
  };

  const setActiveScreen = (index) => {
    currentIndex = index;

    if (heroStreamImg) heroStreamImg.src = STREAM_IMG_SRC;

    applyStackState(heroStackContainer, index);
    applyStackState(showcaseContainer, index);

    checklistItems.forEach((item, idx) => item.classList.toggle('active', idx === index));
  };

  const startAutoSlide = () => {
    stopAutoSlide();
    autoSlideInterval = setInterval(() => {
      setActiveScreen((currentIndex + 1) % 3);
    }, 4500);
  };

  const stopAutoSlide = () => {
    if (autoSlideInterval) clearInterval(autoSlideInterval);
    autoSlideInterval = null;
  };

  checklistItems.forEach((item, idx) => {
    item.addEventListener('click', () => {
      setActiveScreen(idx);
      startAutoSlide();
    });
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopAutoSlide();
    } else {
      startAutoSlide();
    }
  });

  // Start sliding automatically
  startAutoSlide();
</script>

