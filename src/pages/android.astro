---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GoPlay — Watch Live Sports | No Ads & No Buffering</title>
<meta name="description" content="GoPlay tracks matches across football, cricket, and more. Get live scores, match notifications, and multiple high-fidelity streaming links with no login required.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

<style is:global>
  :root {
    --pitch: #17181c;
    --turf: #222326;
    --turf-2: #2c2d31;
    --card: #222326;
    --line: rgba(113, 118, 142, 0.15);
    --signal: #00adb5;
    --signal-glow: rgba(0, 173, 181, 0.3);
    --signal-dim: #008a91;
    --amber: #ffb020;
    --chalk: #f3f4f6;
    --chalk-dim: #71768e;
    --shadow: 0 30px 60px rgba(0,0,0,0.6);
    --gradient-glow: radial-gradient(circle, rgba(0, 173, 181, 0.12) 0%, rgba(113, 118, 142, 0.06) 50%, transparent 100%);
    --container-padding: 24px;
    --max-content-width: 1280px;
  }

  @media (min-width: 768px) {
    :root {
      --container-padding: 40px;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --container-padding: 64px;
    }
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
    width: 100%;
  }
  
  body {
    background: var(--pitch);
    color: var(--chalk);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    width: 100%;
    -webkit-font-smoothing: antialiased;
    position: relative;
  }
  
  ::selection {
    background: var(--signal);
    color: #020704;
  }

  .display {
    font-family: 'Teko', sans-serif;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    line-height: 0.9;
  }
  
  .mono {
    font-family: 'Space Mono', monospace;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
  
  .wrap {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    transition: padding 0.3s ease;
  }

  /* Pure CSS - Skeuomorphic Button */
  .skeuo-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 42px;
    border-radius: 9999px;
    background-image: linear-gradient(180deg, #2d2d30, #18181b);
    border: none;
    box-shadow: 
      0 8px 20px -4px rgba(0, 0, 0, 0.6),
      0 2px 6px -1px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    text-decoration: none;
    line-height: 1;
  }

  .skeuo-button::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0px 0 rgba(255, 255, 255, 0.25);
  }

  .skeuo-button:hover {
    filter: brightness(115%);
    transform: scale(1.02);
  }

  .skeuo-button:active {
    transform: scale(0.95);
    box-shadow: 
      0 2px 4px -1px rgba(0, 0, 0, 0.7),
      inset 0 2px 4px 0 rgba(0, 0, 0, 0.5);
  }

  .skeuo-button-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
  }

  /* Skeuomorphic Color & Size Variations */
  .skeuo-button-primary {
    background-image: linear-gradient(180deg, #00f2fe, #008c94) !important;
    color: #02181a !important;
    font-weight: 700;
    box-shadow: 
      0 10px 25px -4px rgba(0, 173, 181, 0.55),
      0 4px 12px -2px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.4) !important;
  }

  .skeuo-button-primary::before {
    box-shadow: inset 0 1px 0px 0 rgba(255, 255, 255, 0.6) !important;
  }

  .skeuo-button-sm {
    padding: 10px 22px;
    font-size: 14px;
  }

  .skeuo-button-sm .skeuo-button-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
  }

  .skeuo-button-telegram {
    background-image: linear-gradient(180deg, #1fa8ec, #0077b5);
    color: #ffffff;
    box-shadow: 
      0 10px 25px -4px rgba(0, 136, 204, 0.5),
      0 4px 10px -2px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .glow {
    position: absolute;
    width: 600px;
    height: 600px;
    background: var(--gradient-glow);
    pointer-events: none;
    z-index: 0;
    filter: blur(60px);
    opacity: 0.8;
  }
  .glow-1 { top: -100px; right: -100px; }
  .glow-2 { top: 600px; left: -200px; }
  .glow-3 { bottom: 800px; right: -200px; }
  .glow-4 { bottom: -200px; left: 10%; }

  .field-lines {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 159px, rgba(0, 173, 181, 0.015) 160px),
      radial-gradient(circle at 50% 20%, rgba(0, 173, 181, 0.03), transparent 70%);
    opacity: 0.7;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 12px 0;
    background: rgba(23, 24, 28, 0.65);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.3s ease;
  }
  
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--container-padding);
    max-width: var(--max-content-width);
    margin: 0 auto;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Teko', sans-serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--chalk);
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.9;
  }
  
  .logo .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 12px var(--signal);
    display: inline-block;
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 4px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }
  
  .nav-links a {
    font-size: 13.5px;
    color: var(--chalk-dim);
    font-weight: 500;
    padding: 6px 18px;
    border-radius: 999px;
    transition: all 0.2s ease;
    position: relative;
  }

  .nav-links a::after {
    display: none;
  }

  .nav-links a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  @media(max-width:768px) {
    .nav-links { display: none; }
  }

  .hero {
    position: relative;
    z-index: 10;
    padding: 100px var(--container-padding) 80px;
    max-width: var(--max-content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
    transition: padding 0.3s ease, gap 0.3s ease;
  }
  
  @media (min-width: 1024px) {
    .hero {
      padding: 140px var(--container-padding) 100px;
      gap: 80px;
    }
  }
  
  @media(max-width:992px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 60px;
      text-align: center;
      gap: 50px;
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--signal);
    font-weight: 700;
    border: 1px solid var(--line);
    background: rgba(0, 255, 102, 0.04);
    border-radius: 999px;
    padding: 6px 16px;
    margin-bottom: 24px;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  
  .eyebrow .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: pulse 1.6s infinite;
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    }
    50% {
      opacity: 0.4;
      box-shadow: 0 0 0 8px rgba(0, 255, 102, 0);
    }
  }

  .hero h1 {
    font-size: clamp(32px, 8vw, 92px);
    color: var(--chalk);
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    line-height: 1.05;
    letter-spacing: 0.2px;
  }
  
  .hero h1 .desktop-only {
    display: block;
  }
  
  .hero h1 .mobile-only {
    display: none;
  }
  
  .hero h1 .highlight {
    background: linear-gradient(135deg, var(--signal) 30%, #00ddff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  @media(max-width: 992px) {
    .hero h1 .desktop-only {
      display: none;
    }
    .hero h1 .mobile-only {
      display: block;
    }
  }
  
  .hero p.sub {
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--chalk-dim);
    max-width: 520px;
  }
  
  @media(max-width:992px) {
    .hero p.sub { margin: 24px auto 0; }
  }

  @media(max-width:520px) {
    .hero p.sub {
      font-size: 15px;
      line-height: 1.6;
      margin-top: 16px;
    }
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  
  @media(max-width:992px) {
    .hero-actions { justify-content: center; }
  }
  
  @media(max-width:520px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-top: 24px;
    }
    .hero-actions a {
      justify-content: center;
      width: 100%;
    }
  }

  .trust-row {
    display: flex;
    gap: 12px;
    margin-top: 48px;
    flex-wrap: wrap;
  }
  
  @media(max-width:992px) {
    .trust-row { justify-content: center; }
  }

  @media(max-width:520px) {
    .trust-row {
      display: none;
    }
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--chalk-dim);
    font-size: 13px;
    font-weight: 500;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.03), 0 4px 12px rgba(0, 0, 0, 0.15);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trust-badge:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(0, 173, 181, 0.15);
    color: var(--chalk);
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.05), 0 8px 16px rgba(0, 0, 0, 0.25);
  }

  .trust-badge b {
    color: var(--signal);
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    text-shadow: 0 0 8px rgba(0, 173, 181, 0.3);
  }

  .mockup-container {
    position: relative;
    width: 100%;
    max-width: 550px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    perspective: 1000px;
    z-index: 20;
  }

  .marquee-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(34, 35, 38, 0.4);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    padding: 20px 0;
    overflow: hidden;
    position: relative;
    z-index: 10;
  }
  
  .marquee-track {
    display: flex;
    gap: 70px;
    white-space: nowrap;
    animation: scroll 32s linear infinite;
    width: max-content;
    will-change: transform;
  }
  
  .marquee-track span {
    font-family: 'Teko', sans-serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: var(--chalk-dim);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .marquee-track span i {
    width: 6px;
    height: 6px;
    background: var(--signal);
    box-shadow: 0 0 10px var(--signal);
    border-radius: 50%;
  }
  
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  section.block {
    padding: 120px 0;
    position: relative;
    z-index: 10;
  }
  
  .section-head {
    max-width: 680px;
    margin-bottom: 70px;
  }
  
  .section-head .eyebrow {
    margin-bottom: 18px;
  }
  
  .section-head h2 {
    font-size: clamp(38px, 5vw, 56px);
    color: var(--chalk);
  }
  
  .section-head p {
    margin-top: 16px;
    color: var(--chalk-dim);
    font-size: 16px;
    line-height: 1.65;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: visible;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  
  .feature-card {
    padding: 40px 32px;
    position: relative;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 50%, rgba(255, 255, 255, 0) 100%), rgba(23, 24, 28, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.15), 0 15px 35px 0 rgba(0, 0, 0, 0.4);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    contain: layout style;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(255, 255, 255, 0) 100%), rgba(34, 35, 38, 0.75);
    border-color: rgba(0, 173, 181, 0.45);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.2), 0 0 30px rgba(0, 173, 181, 0.12), 0 25px 50px rgba(0,0,0,0.6);
  }

  @media(max-width:950px) {
    .feature-grid { 
      grid-template-columns: repeat(2, 1fr); 
      gap: 20px;
    }
  }
  @media(max-width:600px) {
    .feature-grid { 
      grid-template-columns: 1fr; 
      gap: 16px;
    }
  }
  
  .feature-num {
    font-family: 'Space Mono', monospace;
    color: var(--signal);
    font-size: 13px;
    margin-bottom: 24px;
    display: inline-block;
    border: 1px solid rgba(0, 173, 181, 0.2);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(0, 173, 181, 0.02);
  }
  
  .feature-card h3 {
    font-family: 'Teko', sans-serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    color: var(--chalk);
    text-transform: uppercase;
  }
  
  .feature-card p {
    color: var(--chalk-dim);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  
  @media(max-width:992px) {
    .showcase {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  .phone-stack-container {
    position: relative;
    height: 620px;
    width: 100%;
    max-width: 550px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .phone-stack-item {
    position: absolute;
    width: 290px;
    aspect-ratio: 9/19;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s;
    filter: drop-shadow(0 25px 40px rgba(0,0,0,0.6));
    will-change: transform;
    contain: layout style;
  }

  .phone-stack-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* State 0: Schedule is center */
  .phone-stack-container.state-0 .phone-schedule {
    transform: scale(1) translateZ(50px);
    z-index: 3;
    filter: drop-shadow(0 35px 50px rgba(0,0,0,0.7)) drop-shadow(0 0 20px rgba(0,173,181,0.05));
  }
  .phone-stack-container.state-0 .phone-home {
    transform: translateX(130px) rotate(10deg) scale(0.85);
    z-index: 2;
    filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)) brightness(0.7);
  }
  .phone-stack-container.state-0 .phone-stream {
    transform: translateX(220px) rotate(15deg) scale(0.75);
    z-index: 1;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.6)) brightness(0.5);
  }

  /* State 1: Home is center */
  .phone-stack-container.state-1 .phone-schedule {
    transform: translateX(-130px) rotate(-10deg) scale(0.85);
    z-index: 1;
    filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)) brightness(0.6);
  }
  .phone-stack-container.state-1 .phone-home {
    transform: scale(1) translateZ(50px);
    z-index: 3;
    filter: drop-shadow(0 35px 50px rgba(0,0,0,0.7)) drop-shadow(0 0 20px rgba(0,173,181,0.05));
  }
  .phone-stack-container.state-1 .phone-stream {
    transform: translateX(130px) rotate(10deg) scale(0.85);
    z-index: 2;
    filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)) brightness(0.7);
  }

  /* State 2: Stream is center */
  .phone-stack-container.state-2 .phone-schedule {
    transform: translateX(-220px) rotate(-15deg) scale(0.75);
    z-index: 1;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.6)) brightness(0.5);
  }
  .phone-stack-container.state-2 .phone-home {
    transform: translateX(-130px) rotate(-10deg) scale(0.85);
    z-index: 2;
    filter: drop-shadow(0 15px 25px rgba(0,0,0,0.6)) brightness(0.7);
  }
  .phone-stack-container.state-2 .phone-stream {
    transform: scale(1) translateZ(50px);
    z-index: 3;
    filter: drop-shadow(0 35px 50px rgba(0,0,0,0.7)) drop-shadow(0 0 20px rgba(0,173,181,0.05));
  }

  @media(max-width: 520px) {
    .phone-stack-container {
      height: 450px;
    }
    .phone-stack-item {
      width: 210px;
    }
    
    /* State 0: Schedule is center */
    .phone-stack-container.state-0 .phone-home {
      transform: translateX(50px) rotate(8deg) scale(0.85);
    }
    .phone-stack-container.state-0 .phone-stream {
      transform: translateX(100px) rotate(12deg) scale(0.75);
    }

    /* State 1: Home is center */
    .phone-stack-container.state-1 .phone-schedule {
      transform: translateX(-50px) rotate(-8deg) scale(0.85);
    }
    .phone-stack-container.state-1 .phone-stream {
      transform: translateX(50px) rotate(8deg) scale(0.85);
    }

    /* State 2: Stream is center */
    .phone-stack-container.state-2 .phone-schedule {
      transform: translateX(-100px) rotate(-12deg) scale(0.75);
    }
    .phone-stack-container.state-2 .phone-home {
      transform: translateX(-50px) rotate(-8deg) scale(0.85);
    }
  }

  .showcase-copy .checklist {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  
  .check-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .check-item:hover {
    background: rgba(0, 173, 181, 0.02);
    border-color: rgba(0, 173, 181, 0.1);
    transform: translateX(6px);
  }

  .check-item.active {
    background: rgba(0, 173, 181, 0.04);
    border-color: rgba(0, 173, 181, 0.2);
    box-shadow: 0 8px 30px rgba(0, 173, 181, 0.02);
  }

  .check-item.active .check-mark {
    background: var(--signal);
    color: var(--pitch);
    box-shadow: 0 0 12px rgba(0, 173, 181, 0.4);
    border-color: var(--signal);
  }
  
  .check-mark {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 8px;
    background: rgba(0, 173, 181, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--signal);
    font-size: 12px;
    font-weight: 800;
    border: 1px solid rgba(0, 173, 181, 0.25);
  }
  
