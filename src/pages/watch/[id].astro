---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;

// Fetch all channels to do slug matching
const { data: channels } = await supabase.from('channels').select('*');

export function slugify(text) {
  return text
    .toString()
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^\w\-]+/g, '')
    .replace(/\-\-+/g, '-')
    .replace(/^-+/, '')
    .replace(/-+$/, '');
}

export function getChannelSlug(channel) {
  const nameSlug = slugify(channel.name);
  const chId = channel.id;
  if (chId.startsWith(nameSlug) || chId.endsWith(nameSlug)) {
    return chId;
  }
  return `${nameSlug}-${chId}`;
}

const channel = (channels || []).find(ch => getChannelSlug(ch) === id || ch.id === id);

if (!channel) {
  return Astro.redirect('/');
}

const nameLower = channel.name.toLowerCase();
const hasLiveWord = nameLower.endsWith('live') || nameLower.includes(' live ') || nameLower.includes(' live(') || nameLower.includes(' live');

let title = hasLiveWord 
  ? `Watch ${channel.name} | GoPlay` 
  : `Watch ${channel.name} Live | GoPlay`;
let description = `Watch ${channel.name} live stream in HD quality. Access sports, movies, news, and entertainment with GoPlay player.`;
let keywords = `Watch ${channel.name} Live, ${channel.name} Live Stream, ${channel.name} Online, watch live tv, iptv player, GoPlay`;

if (channel.id === 'go-fifa-live') {
  title = `Watch Go FIFA Live Stream Free | GoPlay`;
  description = `Watch Go FIFA Live stream in HD quality online. Access free sports, football matches, and live events with GoPlay player, no registration required.`;
  keywords = `Go FIFA Live, Watch Go FIFA Live, Go FIFA Live Stream, FIFA Live Online, Watch FIFA matches free, sports live stream, GoPlay`;
} else if (channel.id.includes('world-cup-2026') || channel.id === 'sports-world-cup-2026') {
  title = `FIFA World Cup 2026 Live Stream | GoPlay`;
  description = `Watch FIFA World Cup 2026 live stream on GoPlay. Enjoy HD sports streaming with no interruptions and no signup required..`;
  keywords = `FIFA World Cup 2026, FIFA World Cup live, watch World Cup 2026 online, free World Cup stream, live sports streaming, GoPlay`;
} else if (channel.id === 'sports-cazetv') {
  title = `CazeTV Live - FIFA World Cup Football | GoPlay`;
  description = `Watch FIFA World Cup live on CazeTV with GoPlay. Enjoy HD sports streaming with no interruptions and no signup required..`;
  keywords = `CazeTV, watch CazeTV live, CazeTV live stream, FIFA World Cup, FIFA World Cup live, sports streaming, GoPlay`;
} else if (channel.id === 'sports-beinsports') {
  title = `BeinSports Live - FIFA World Cup Football | GoPlay`;
  description = `Watch FIFA World Cup live on BeinSports with GoPlay. Enjoy HD sports streaming with no interruptions and no signup required..`;
  keywords = `BeinSports, watch BeinSports live, BeinSports live stream, FIFA World Cup, FIFA World Cup live, sports streaming, GoPlay`;
}

const image = channel.logo || "http://goplay.pro.bd/assets/goplay-og.png";
const activeChannelId = channel.id;

// Generate Schema.org structured data for rich snippet search results
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${Astro.url.href}#webpage`,
      "url": Astro.url.href,
      "name": title,
      "description": description,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${Astro.url.origin}/#website`,
        "url": `${Astro.url.origin}/`,
        "name": "GoPlay"
      }
    },
    {
      "@type": "BroadcastService",
      "@id": `${Astro.url.href}#broadcastservice`,
      "name": channel.name,
      "broadcastDisplayName": channel.name,
      "videoFormat": "HD",
      "description": description,
      "logo": image,
      "url": Astro.url.href,
      "provider": {
        "@type": "Organization",
        "name": "GoPlay",
        "url": Astro.url.origin
      }
    }
  ]
};
---
<MainLayout title={title} description={description} keywords={keywords} image={image} activeChannelId={activeChannelId} schema={schema} />
