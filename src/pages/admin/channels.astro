---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

let errorMsg = '';
let successMsg = '';

// Handle CRUD Operations via POST
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'delete') {
      const deleteId = data.get('id')?.toString().trim();
      if (deleteId) {
        const { error } = await supabase
          .from('channels')
          .delete()
          .eq('id', deleteId);

        if (error) {
          errorMsg = error.message;
        } else {
          successMsg = 'Channel deleted successfully!';
        }
      }
    } else if (action === 'bulk_delete') {
      const idsRaw = data.get('ids')?.toString().trim();
      if (idsRaw) {
        const ids = idsRaw.split(',').map(id => id.trim()).filter(Boolean);
        if (ids.length > 0) {
          const { error } = await supabase
            .from('channels')
            .delete()
            .in('id', ids);

          if (error) {
            errorMsg = error.message;
          } else {
            successMsg = `${ids.length} channels deleted successfully!`;
          }
        }
      }
    } else if (action === 'bulk_change_category') {
      const idsRaw = data.get('ids')?.toString().trim();
      const newCategory = data.get('category')?.toString().trim() || null;
      if (idsRaw) {
        const ids = idsRaw.split(',').map(id => id.trim()).filter(Boolean);
        if (ids.length > 0) {
          const { error } = await supabase
            .from('channels')
            .update({ category: newCategory })
            .in('id', ids);

          if (error) {
            errorMsg = error.message;
          } else {
            successMsg = `Category updated for ${ids.length} channels!`;
          }
        }
      }
    } else if (action === 'bulk_update_status') {
      const idsRaw = data.get('ids')?.toString().trim();
      const field = data.get('field')?.toString().trim();
      const value = data.get('value') === 'true';
      if (idsRaw && field && ['proxy', 'is_live', 'is_trending'].includes(field)) {
        const ids = idsRaw.split(',').map(id => id.trim()).filter(Boolean);
        if (ids.length > 0) {
          const { error } = await supabase
            .from('channels')
            .update({ [field]: value })
            .in('id', ids);

          if (error) {
            errorMsg = error.message;
          } else {
            const statusLabel = field === 'is_live' ? 'Live status' : field === 'is_trending' ? 'Trending status' : 'Proxy status';
            successMsg = `${statusLabel} updated for ${ids.length} channels!`;
          }
        }
      }
    } else {
      const id = data.get('id')?.toString().trim();
      const name = data.get('name')?.toString().trim();
      const logo = data.get('logo')?.toString().trim() || null;
      const category = data.get('category')?.toString().trim() || null;
      const country = data.get('country')?.toString().trim() || null;
      const language = data.get('language')?.toString().trim() || null;
      const is_live = data.get('is_live') === 'true';
      const is_trending = data.get('is_trending') === 'true';
      const quality = data.get('quality')?.toString().trim() || 'HD';
      const stream_url = data.get('stream_url')?.toString().trim() || null;
      const url = data.get('url')?.toString().trim() || null;
      const sort_order = parseInt(data.get('sort_order')?.toString() || '0');
      const proxy = data.get('proxy') === 'true';

      // Parse Headers JSON safely
      let headers = {};
      const headersRaw = data.get('headers')?.toString().trim();
      if (headersRaw) {
        try {
          headers = JSON.parse(headersRaw);
        } catch (e) {
          errorMsg = 'Invalid Request Headers JSON formatting.';
        }
      }

      // DRM configuration
      const drm_kid = data.get('drm_kid')?.toString().trim();
      const drm_key = data.get('drm_key')?.toString().trim();
      const drm = (drm_kid && drm_key) ? { kid: drm_kid, key: drm_key } : null;

      if (!errorMsg) {
        if (action === 'create') {
          if (!id || !name) {
            errorMsg = 'Channel ID and Name are required.';
          } else {
            const { error } = await supabase
              .from('channels')
              .insert({ id, name, logo, category, country, language, is_live, is_trending, quality, stream_url, url, headers, sort_order, proxy, drm });

            if (error) {
              errorMsg = error.message;
            } else {
              successMsg = `Channel "${name}" created successfully!`;
            }
          }
        } else if (action === 'update') {
          const originalId = data.get('original_id')?.toString().trim();
          if (!id || !name || !originalId) {
            errorMsg = 'Channel ID and Name are required.';
          } else {
            const { error } = await supabase
              .from('channels')
              .update({ id, name, logo, category, country, language, is_live, is_trending, quality, stream_url, url, headers, sort_order, proxy, drm })
              .eq('id', originalId);

            if (error) {
              errorMsg = error.message;
            } else {
              successMsg = `Channel "${name}" updated successfully!`;
            }
          }
        }
      }
    }
  } catch (e) {
    errorMsg = 'An unexpected server error occurred.';
  }
}

// Fetch all categories for dropdown
const { data: categories } = await supabase
  .from('channel_categories')
  .select('*')
  .order('sort_order', { ascending: true });

// Fetch all channels
const { data: channels, error: fetchError } = await supabase
  .from('channels')
  .select('*')
  .order('category', { ascending: true })
  .order('sort_order', { ascending: true });

// Check if editing
const editId = Astro.url.searchParams.get('edit');
let editChannel = null;
if (editId && channels) {
  editChannel = channels.find(ch => ch.id === editId);
}

const isCreating = Astro.url.searchParams.get('action') === 'new' || editChannel;
---

<AdminLayout title="Manage Channels | GoPlay" activeTab="channels">
  <div class="page-title-section flex-header">
    <div>
      <h1 class="page-title">Live Channels</h1>
      <p class="page-subtitle">Add, edit, or delete live streams and DRM configurations.</p>
    </div>
    <a href={isCreating ? "/admin/channels" : "/admin/channels?action=new"} class="btn btn-primary">
      {isCreating ? "View Channels List" : "Add New Channel"}
    </a>
  </div>

  {errorMsg && (
    <div class="alert-box alert-danger">
      <span>⚠️</span> {errorMsg}
    </div>
  )}

  {successMsg && (
    <div class="alert-box alert-success">
      <span>✅</span> {successMsg}
    </div>
  )}

  {isCreating ? (
    <!-- Add / Edit Form -->
    <div class="card form-card">
      <h2 class="form-title">{editChannel ? `Edit Channel: ${editChannel.name}` : 'Create New Channel'}</h2>
      <form method="POST" autocomplete="off" id="channelForm">
        <input type="hidden" name="action" value={editChannel ? "update" : "create"} />
        {editChannel && <input type="hidden" name="original_id" value={editChannel.id} />}

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="name">Channel Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="form-control" 
              value={editChannel ? editChannel.name : ''} 
              placeholder="e.g. TSN Sports 1 HD" 
              required
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="id">Channel ID (unique string)</label>
            <input 
              type="text" 
              id="id" 
              name="id" 
              class="form-control" 
              value={editChannel ? editChannel.id : ''} 
              placeholder="e.g. tsn-sports-1-hd" 
              required
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="category">Category</label>
            <select id="category" name="category" class="form-control" style="background: #111;">
              <option value="">-- No Category --</option>
              {categories && categories.map(cat => (
                <option value={cat.key} selected={editChannel && editChannel.category === cat.key}>{cat.name}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="quality">Quality Mode</label>
            <select id="quality" name="quality" class="form-control" style="background: #111;">
              <option value="SD" selected={editChannel && editChannel.quality === 'SD'}>SD (Standard Definition)</option>
              <option value="HD" selected={!editChannel || editChannel.quality === 'HD'}>HD (High Definition)</option>
              <option value="FHD" selected={editChannel && editChannel.quality === 'FHD'}>FHD (Full HD)</option>
              <option value="4K" selected={editChannel && editChannel.quality === '4K'}>4K (Ultra HD)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="logo">Logo URL</label>
          <input 
            type="url" 
            id="logo" 
            name="logo" 
            class="form-control" 
            value={editChannel ? editChannel.logo : ''} 
            placeholder="https://example.com/logo.png"
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="stream_url">Stream URL (M3U8 / MPD / TS)</label>
          <input 
            type="text" 
            id="stream_url" 
            name="stream_url" 
            class="form-control" 
            value={editChannel ? editChannel.stream_url : ''} 
            placeholder="https://example.com/live/playlist.m3u8"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="url">Backup / Fallback Stream URL (Optional)</label>
          <input 
            type="text" 
            id="url" 
            name="url" 
            class="form-control" 
            value={editChannel ? editChannel.url : ''} 
            placeholder="https://example.com/live/backup.m3u8"
          />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="country">Country</label>
            <input 
              type="text" 
              id="country" 
              name="country" 
              class="form-control" 
              value={editChannel ? editChannel.country : ''} 
              placeholder="e.g. USA, Canada"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="language">Language</label>
            <input 
              type="text" 
              id="language" 
              name="language" 
              class="form-control" 
              value={editChannel ? editChannel.language : ''} 
              placeholder="e.g. English, Spanish"
            />
          </div>
          <div class="form-group">
            <label class="form-label" for="sort_order">Sort Order</label>
            <input 
              type="number" 
              id="sort_order" 
              name="sort_order" 
              class="form-control" 
              value={editChannel ? editChannel.sort_order : '0'} 
              placeholder="0"
            />
          </div>
        </div>

        <!-- Checkbox Options -->
        <div class="form-row" style="margin: 1.5rem 0;">
          <label class="form-checkbox">
            <input type="checkbox" name="is_live" value="true" checked={!editChannel || editChannel.is_live} />
            <span>Is Live Stream?</span>
          </label>
          <label class="form-checkbox">
            <input type="checkbox" name="is_trending" value="true" checked={editChannel && editChannel.is_trending} />
            <span>Show in Trending?</span>
          </label>
          <label class="form-checkbox">
            <input type="checkbox" name="proxy" value="true" checked={editChannel && editChannel.proxy} />
            <span>Proxy stream via server (bypass CORS)?</span>
          </label>
        </div>

        <!-- DRM Section -->
        <div class="drm-section-card">
          <h3 class="subsection-title">🔑 DRM / ClearKey Configuration (Optional)</h3>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="drm_kid">DRM Key ID (KID) - Hex</label>
              <input 
                type="text" 
                id="drm_kid" 
                name="drm_kid" 
                class="form-control" 
                value={editChannel && editChannel.drm ? editChannel.drm.kid : ''} 
                placeholder="e.g. 1a2b3c4d5e6f..."
              />
            </div>
            <div class="form-group">
              <label class="form-label" for="drm_key">DRM Key - Hex</label>
              <input 
                type="text" 
                id="drm_key" 
                name="drm_key" 
                class="form-control" 
                value={editChannel && editChannel.drm ? editChannel.drm.key : ''} 
                placeholder="e.g. 9f8e7d6c5b4a..."
              />
            </div>
          </div>
        </div>

        <!-- HTTP Request Headers (JSON) -->
        <div class="form-group" style="margin-top: 1.5rem;">
          <label class="form-label" for="headers">Custom HTTP Request Headers (JSON Format)</label>
          <textarea 
            id="headers" 
            name="headers" 
            class="form-control" 
            rows="3" 
            placeholder='{"User-Agent": "Mozilla/5.0...", "Referer": "https://..."}'
          >{editChannel && editChannel.headers ? JSON.stringify(editChannel.headers, null, 2) : ''}</textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            {editChannel ? "Save Changes" : "Create Channel"}
          </button>
          <a href="/admin/channels" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  ) : (
    <!-- Channels List & Instant Search -->
    <div>
      <div class="filters-grid">
        <input type="text" id="adminSearchInput" class="form-control" placeholder="🔍 Search by name, ID, category or URL..." />
        
        <select id="adminCategoryFilter" class="form-control select-filter">
          <option value="">📁 All Categories</option>
          {categories && categories.map(cat => (
            <option value={cat.key}>{cat.name}</option>
          ))}
        </select>
        
        <select id="adminQualityFilter" class="form-control select-filter">
          <option value="">📺 All Qualities</option>
          <option value="SD">SD</option>
          <option value="HD">HD</option>
          <option value="FHD">FHD</option>
          <option value="4K">4K</option>
        </select>

        <select id="adminDrmFilter" class="form-control select-filter">
          <option value="">🔑 All DRM Status</option>
          <option value="true">DRM Protected</option>
          <option value="false">No DRM</option>
        </select>

        <select id="adminProxyFilter" class="form-control select-filter">
          <option value="">🌐 All Proxy Status</option>
          <option value="true">Proxy Active</option>
          <option value="false">No Proxy</option>
        </select>
      </div>

      <div class="table-container">
        <table class="admin-table" id="channelsTable">
          <thead>
            <tr>
              <th style="width: 40px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" style="cursor: pointer;" /></th>
              <th style="width: 60px;">Logo</th>
              <th>Channel Name</th>
              <th>ID</th>
              <th>Category</th>
              <th>Quality</th>
              <th>DRM</th>
              <th>Proxy</th>
              <th style="text-align: right; width: 150px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {channels && channels.length > 0 ? (
              channels.map(ch => (
                <tr class="channel-row" 
                    data-name={ch.name.toLowerCase()} 
                    data-id={ch.id.toLowerCase()} 
                    data-category={ch.category ? ch.category.toLowerCase() : ''} 
                    data-url={ch.stream_url ? ch.stream_url.toLowerCase() : ''}
                    data-quality={ch.quality ? ch.quality.toLowerCase() : 'hd'}
                    data-drm={ch.drm ? 'true' : 'false'}
                    data-proxy={ch.proxy ? 'true' : 'false'}
                >
                  <td style="text-align: center;">
                    <input type="checkbox" class="channel-select-checkbox" data-channel-id={ch.id} style="cursor: pointer;" />
                  </td>
                  <td>
                    {ch.logo ? (
                      <img src={ch.logo} alt={ch.name} class="table-logo" onerror="this.src='/assets/logo.webp'" />
                    ) : (
                      <div class="table-logo-placeholder">📺</div>
                    )}
                  </td>
                  <td class="font-bold">{ch.name}</td>
                  <td><code>{ch.id}</code></td>
                  <td><span class="badge badge-primary">{ch.category || 'none'}</span></td>
                  <td><span class="badge badge-success">{ch.quality}</span></td>
                  <td>
                    {ch.drm ? (
                      <span class="badge badge-primary" style="background: rgba(139, 92, 246, 0.1); color: #a78bfa;">ClearKey</span>
                    ) : (
                      <span class="text-muted" style="font-size: 0.8rem;">No</span>
                    )}
                  </td>
                  <td>
                    {ch.proxy ? (
                      <span class="badge badge-success">Active</span>
                    ) : (
                      <span class="text-muted" style="font-size: 0.8rem;">No</span>
                    )}
                  </td>
                  <td style="text-align: right;">
                    <div class="action-buttons-group">
                      <a href={`/admin/channels?edit=${ch.id}`} class="btn btn-secondary btn-sm" title="Edit">✏️</a>
                      <form method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this channel?');">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={ch.id} />
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete">🗑️</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="9" style="text-align: center; padding: 4rem;" class="text-muted">
                  No channels found. Add your first stream channel!
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <!-- Bulk Actions Bar -->
  <div id="bulkActionsBar" class="bulk-actions-bar">
    <div class="bulk-actions-content">
      <div class="bulk-info">
        <span class="bulk-count-badge" id="bulkCountBadge">0</span>
        <span class="bulk-info-text">channels selected</span>
      </div>
      
      <div class="bulk-divider"></div>
      
      <div class="bulk-actions-group">
        <!-- Change Category Action -->
        <div class="bulk-action-item">
          <select id="bulkCategorySelect" class="form-control select-filter" style="width: auto; min-width: 170px; margin: 0;">
            <option value="">📁 Move to Category...</option>
            {categories && categories.map(cat => (
              <option value={cat.key}>{cat.name}</option>
            ))}
            <option value="none">❌ Remove Category</option>
          </select>
          <button type="button" id="bulkChangeCategoryBtn" class="btn btn-secondary btn-sm">Move</button>
        </div>

        <div class="bulk-divider"></div>

        <!-- Toggle Status Options -->
        <div class="bulk-action-item">
          <select id="bulkStatusSelect" class="form-control select-filter" style="width: auto; min-width: 170px; margin: 0;">
            <option value="">⚙️ Toggle Status...</option>
            <option value="proxy:true">🌐 Enable Proxy</option>
            <option value="proxy:false">🌐 Disable Proxy</option>
            <option value="is_live:true">⚡ Set as Live</option>
            <option value="is_live:false">⚡ Set as Offline</option>
            <option value="is_trending:true">🔥 Enable Trending</option>
            <option value="is_trending:false">🔥 Disable Trending</option>
          </select>
          <button type="button" id="bulkStatusBtn" class="btn btn-secondary btn-sm">Apply</button>
        </div>

        <div class="bulk-divider"></div>

        <!-- Delete Action -->
        <button type="button" id="bulkDeleteBtn" class="btn btn-danger btn-sm">🗑️ Delete Selected</button>

        <div class="bulk-divider"></div>

        <!-- Cancel Selection -->
        <button type="button" id="bulkCancelBtn" class="btn bulk-cancel-btn btn-sm" title="Clear selection">✕ Cancel</button>
      </div>
    </div>
  </div>

  <!-- Hidden form for bulk actions submission -->
  <form id="bulkActionForm" method="POST" style="display: none;">
    <input type="hidden" name="action" id="bulkActionInput" />
    <input type="hidden" name="ids" id="bulkIdsInput" />
    <input type="hidden" name="category" id="bulkCategoryInput" />
    <input type="hidden" name="field" id="bulkFieldInput" />
    <input type="hidden" name="value" id="bulkValueInput" />
  </form>
</AdminLayout>

<script>
  // Dynamic slug generation on Name input
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const idInput = document.getElementById('id') as HTMLInputElement;

  if (nameInput && idInput) {
    nameInput.addEventListener('input', () => {
      // Only auto-generate ID if it was empty or matched the slug of the previous name
      const currentSlug = nameInput.value
        .toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');

      // Only autofill if the field has not been manually touched/edited by user
      if (document.activeElement !== idInput && (!idInput.value || idInput.value.length === 0)) {
        idInput.value = currentSlug;
      }
    });
  }

  // Real-time multi-criteria filter
  const searchInput = document.getElementById('adminSearchInput') as HTMLInputElement;
  const categoryFilter = document.getElementById('adminCategoryFilter') as HTMLSelectElement;
  const qualityFilter = document.getElementById('adminQualityFilter') as HTMLSelectElement;
  const drmFilter = document.getElementById('adminDrmFilter') as HTMLSelectElement;
  const proxyFilter = document.getElementById('adminProxyFilter') as HTMLSelectElement;

  function filterTable() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const selectedCategory = categoryFilter ? categoryFilter.value.toLowerCase() : '';
    const selectedQuality = qualityFilter ? qualityFilter.value.toLowerCase() : '';
    const selectedDrm = drmFilter ? drmFilter.value : '';
    const selectedProxy = proxyFilter ? proxyFilter.value : '';

    const rows = document.querySelectorAll('.channel-row') as NodeListOf<HTMLTableRowElement>;

    rows.forEach(row => {
      const name = row.dataset.name || '';
      const id = row.dataset.id || '';
      const category = row.dataset.category || '';
      const url = row.dataset.url || '';
      const quality = row.dataset.quality || '';
      const drm = row.dataset.drm || 'false';
      const proxy = row.dataset.proxy || 'false';

      // Check filters
      const matchesSearch = !query || name.includes(query) || id.includes(query) || category.includes(query) || url.includes(query);
      const matchesCategory = !selectedCategory || category === selectedCategory;
      const matchesQuality = !selectedQuality || quality === selectedQuality;
      const matchesDrm = !selectedDrm || drm === selectedDrm;
      const matchesProxy = !selectedProxy || proxy === selectedProxy;

      if (matchesSearch && matchesCategory && matchesQuality && matchesDrm && matchesProxy) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
        // Uncheck hidden rows if checked
        const cb = row.querySelector('.channel-select-checkbox') as HTMLInputElement;
        if (cb && cb.checked) {
          cb.checked = false;
        }
      }
    });

    // Update select checkboxes bar
    if (typeof updateBulkActionsBar === 'function') {
      updateBulkActionsBar();
    }
  }

  [searchInput, categoryFilter, qualityFilter, drmFilter, proxyFilter].forEach(el => {
    if (el) {
      const eventType = el.tagName === 'SELECT' ? 'change' : 'input';
      el.addEventListener(eventType, filterTable);
    }
  });

  // Select All functionality and bulk toolbar logic
  const selectAllCheckbox = document.getElementById('selectAllCheckbox') as HTMLInputElement;
  const itemCheckboxes = document.querySelectorAll('.channel-select-checkbox') as NodeListOf<HTMLInputElement>;
  const bulkActionsBar = document.getElementById('bulkActionsBar');
  const bulkCountBadge = document.getElementById('bulkCountBadge');
  
  // Hidden Form inputs
  const bulkActionForm = document.getElementById('bulkActionForm') as HTMLFormElement;
  const bulkActionInput = document.getElementById('bulkActionInput') as HTMLInputElement;
  const bulkIdsInput = document.getElementById('bulkIdsInput') as HTMLInputElement;
  const bulkCategoryInput = document.getElementById('bulkCategoryInput') as HTMLInputElement;
  const bulkFieldInput = document.getElementById('bulkFieldInput') as HTMLInputElement;
  const bulkValueInput = document.getElementById('bulkValueInput') as HTMLInputElement;

  // Buttons inside bulk bar
  const bulkChangeCategoryBtn = document.getElementById('bulkChangeCategoryBtn');
  const bulkCategorySelect = document.getElementById('bulkCategorySelect') as HTMLSelectElement;
  const bulkStatusBtn = document.getElementById('bulkStatusBtn');
  const bulkStatusSelect = document.getElementById('bulkStatusSelect') as HTMLSelectElement;
  const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');

  function updateBulkActionsBar() {
    const checkedCheckboxes = Array.from(itemCheckboxes).filter(cb => cb.checked);
    const count = checkedCheckboxes.length;

    if (count > 0) {
      if (bulkCountBadge) bulkCountBadge.textContent = count.toString();
      if (bulkActionsBar) bulkActionsBar.classList.add('active');
    } else {
      if (bulkActionsBar) bulkActionsBar.classList.remove('active');
    }

    // Synchronize selectAll checkbox state based on visible checkboxes
    const visibleCheckboxes = Array.from(itemCheckboxes).filter(cb => {
      const row = cb.closest('.channel-row') as HTMLElement;
      return row && row.style.display !== 'none';
    });

    if (visibleCheckboxes.length > 0) {
      const allVisibleChecked = visibleCheckboxes.every(cb => cb.checked);
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = allVisibleChecked;
        selectAllCheckbox.indeterminate = !allVisibleChecked && visibleCheckboxes.some(cb => cb.checked);
      }
    } else {
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }
    }
  }

  if (selectAllCheckbox) {
    selectAllCheckbox.addEventListener('change', () => {
      const checked = selectAllCheckbox.checked;
      itemCheckboxes.forEach(cb => {
        const row = cb.closest('.channel-row') as HTMLElement;
        // Only select/deselect visible rows to align with search filters
        if (row && row.style.display !== 'none') {
          cb.checked = checked;
        }
      });
      updateBulkActionsBar();
    });
  }

  itemCheckboxes.forEach(cb => {
    cb.addEventListener('change', updateBulkActionsBar);
  });

  function getSelectedIds() {
    return Array.from(itemCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.dataset.channelId || '')
      .filter(Boolean);
  }

  // Handle Cancel Selection
  const bulkCancelBtn = document.getElementById('bulkCancelBtn');
  if (bulkCancelBtn) {
    bulkCancelBtn.addEventListener('click', () => {
      // Uncheck all checkboxes
      itemCheckboxes.forEach(cb => { cb.checked = false; });
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }
      // Reset dropdowns
      if (bulkCategorySelect) bulkCategorySelect.selectedIndex = 0;
      if (bulkStatusSelect) bulkStatusSelect.selectedIndex = 0;
      // Hide the bar
      if (bulkActionsBar) bulkActionsBar.classList.remove('active');
    });
  }

  // Handle Bulk Delete
  if (bulkDeleteBtn && bulkActionForm) {
    bulkDeleteBtn.addEventListener('click', () => {
      const ids = getSelectedIds();
      if (ids.length === 0) return;

      if (confirm(`⚠️ Are you sure you want to permanently delete all ${ids.length} selected channels?`)) {
        bulkActionInput.value = 'bulk_delete';
        bulkIdsInput.value = ids.join(',');
        bulkActionForm.submit();
      }
    });
  }

  // Handle Bulk Move Category
  if (bulkChangeCategoryBtn && bulkCategorySelect && bulkActionForm) {
    bulkChangeCategoryBtn.addEventListener('click', () => {
      const ids = getSelectedIds();
      if (ids.length === 0) return;

      const selectedCat = bulkCategorySelect.value;
      if (!selectedCat) {
        alert('Please choose a category first.');
        return;
      }

      const catLabel = selectedCat === 'none' ? 'No Category' : bulkCategorySelect.options[bulkCategorySelect.selectedIndex].text;
      if (confirm(`Move ${ids.length} channels to category "${catLabel}"?`)) {
        bulkActionInput.value = 'bulk_change_category';
        bulkIdsInput.value = ids.join(',');
        bulkCategoryInput.value = selectedCat === 'none' ? '' : selectedCat;
        bulkActionForm.submit();
      }
    });
  }

  // Handle Bulk Toggle Status Flags
  if (bulkStatusBtn && bulkStatusSelect && bulkActionForm) {
    bulkStatusBtn.addEventListener('click', () => {
      const ids = getSelectedIds();
      if (ids.length === 0) return;

      const selectedStatus = bulkStatusSelect.value;
      if (!selectedStatus) {
        alert('Please select a status action first.');
        return;
      }

      const [field, valStr] = selectedStatus.split(':');
      const value = valStr === 'true';
      const label = bulkStatusSelect.options[bulkStatusSelect.selectedIndex].text;

      if (confirm(`Apply status action "${label}" to ${ids.length} channels?`)) {
        bulkActionInput.value = 'bulk_update_status';
        bulkIdsInput.value = ids.join(',');
        bulkFieldInput.value = field;
        bulkValueInput.value = value ? 'true' : 'false';
        bulkActionForm.submit();
      }
    });
  }
</script>

