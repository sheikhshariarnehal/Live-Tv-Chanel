<Page
    x:Class="GoPlay_IPTV_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GoPlay_IPTV_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ThemeBrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="24" Spacing="16">
            <Button Command="{Binding GoBackCommand}" Width="40" Height="40" CornerRadius="20" Background="#1DFFFFFF" BorderBrush="Transparent">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource TextBlockHeadlineMd}" Foreground="White" />
                <TextBlock Text="Configure IPTV playback and preferences" Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
            </StackPanel>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- Playback Group -->
                <TextBlock Text="Playback Settings" Style="{StaticResource TextBlockTitleSm}" Foreground="{StaticResource ThemeBrushPrimary}" />
                <Border Background="#E61B1B1B" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#404752">
                    <StackPanel Spacing="16">
                        <!-- Quality -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Default Streaming Quality" Style="{StaticResource TextBlockBodyMd}" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Set preferred video quality for streams" Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <!-- Cache Toggle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Local Offline Caching" Style="{StaticResource TextBlockBodyMd}" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Save channels metadata locally to reduce loading lag" Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding EnableCaching, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Personalization Group -->
                <TextBlock Text="Appearance Settings" Style="{StaticResource TextBlockTitleSm}" Foreground="{StaticResource ThemeBrushPrimary}" />
                <Border Background="#E61B1B1B" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#404752">
                    <!-- Theme -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="App Theme Mode" Style="{StaticResource TextBlockBodyMd}" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Select Light, Dark, or System visual style" Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- About Group -->
                <TextBlock Text="About GoPlay IPTV" Style="{StaticResource TextBlockTitleSm}" Foreground="{StaticResource ThemeBrushPrimary}" />
                <Border Background="#E61B1B1B" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#404752">
                    <StackPanel Spacing="8">
                        <TextBlock Text="GoPlay IPTV for Windows" Style="{StaticResource TextBlockBodyMd}" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Version 1.0.0-beta.1 (.NET 9 / WinUI 3)" Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
                        <TextBlock Text="© 2026 GoPlay IPTV Project. All rights reserved." Style="{StaticResource TextBlockLabelXs}" Foreground="{StaticResource ThemeBrushOnSurfaceVariant}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
