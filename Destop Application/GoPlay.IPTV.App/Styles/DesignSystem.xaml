<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Resources -->
    <Color x:Key="ThemeColorBackground">#131313</Color>
    <Color x:Key="ThemeColorSurface">#131313</Color>
    <Color x:Key="ThemeColorSurfaceLow">#1b1b1b</Color>
    <Color x:Key="ThemeColorSurfaceContainer">#20201F</Color>
    <Color x:Key="ThemeColorSurfaceHigh">#2A2A2A</Color>
    <Color x:Key="ThemeColorSurfaceHighest">#353535</Color>
    <Color x:Key="ThemeColorOnSurface">#E5E2E1</Color>
    <Color x:Key="ThemeColorOnSurfaceVariant">#C0C7D4</Color>
    
    <Color x:Key="ThemeColorPrimary">#A3C9FF</Color>
    <Color x:Key="ThemeColorOnPrimary">#00315C</Color>
    <Color x:Key="ThemeColorPrimaryContainer">#0078D4</Color>
    <Color x:Key="ThemeColorOnPrimaryContainer">#FFFFFF</Color>
    
    <Color x:Key="ThemeColorSecondary">#74D1FF</Color>
    <Color x:Key="ThemeColorOnSecondary">#003548</Color>
    
    <Color x:Key="ThemeColorOutline">#8A919E</Color>
    <Color x:Key="ThemeColorOutlineVariant">#404752</Color>
    <Color x:Key="ThemeColorError">#FFB4AB</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="ThemeBrushBackground" Color="{StaticResource ThemeColorBackground}" />
    <SolidColorBrush x:Key="ThemeBrushSurface" Color="{StaticResource ThemeColorSurface}" />
    <SolidColorBrush x:Key="ThemeBrushSurfaceLow" Color="{StaticResource ThemeColorSurfaceLow}" />
    <SolidColorBrush x:Key="ThemeBrushSurfaceContainer" Color="{StaticResource ThemeColorSurfaceContainer}" />
    <SolidColorBrush x:Key="ThemeBrushSurfaceHigh" Color="{StaticResource ThemeColorSurfaceHigh}" />
    <SolidColorBrush x:Key="ThemeBrushSurfaceHighest" Color="{StaticResource ThemeColorSurfaceHighest}" />
    <SolidColorBrush x:Key="ThemeBrushOnSurface" Color="{StaticResource ThemeColorOnSurface}" />
    <SolidColorBrush x:Key="ThemeBrushOnSurfaceVariant" Color="{StaticResource ThemeColorOnSurfaceVariant}" />
    
    <SolidColorBrush x:Key="ThemeBrushPrimary" Color="{StaticResource ThemeColorPrimary}" />
    <SolidColorBrush x:Key="ThemeBrushOnPrimary" Color="{StaticResource ThemeColorOnPrimary}" />
    <SolidColorBrush x:Key="ThemeBrushPrimaryContainer" Color="{StaticResource ThemeColorPrimaryContainer}" />
    <SolidColorBrush x:Key="ThemeBrushOnPrimaryContainer" Color="{StaticResource ThemeColorOnPrimaryContainer}" />
    
    <SolidColorBrush x:Key="ThemeBrushSecondary" Color="{StaticResource ThemeColorSecondary}" />
    <SolidColorBrush x:Key="ThemeBrushOnSecondary" Color="{StaticResource ThemeColorOnSecondary}" />
    
    <SolidColorBrush x:Key="ThemeBrushOutline" Color="{StaticResource ThemeColorOutline}" />
    <SolidColorBrush x:Key="ThemeBrushOutlineVariant" Color="{StaticResource ThemeColorOutlineVariant}" />
    <SolidColorBrush x:Key="ThemeBrushError" Color="{StaticResource ThemeColorError}" />

    <!-- Font Families (Bundled/System Fallbacks) -->
    <FontFamily x:Key="FontFamilyHeader">Libre Franklin, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyBody">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Geist, Consolas, Courier New</FontFamily>

    <!-- Corner Radius Tokens -->
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    
    <!-- Typography Styles -->
    <Style x:Key="TextBlockDisplayLg" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyHeader}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-20" /> <!-- -0.02em -->
    </Style>

    <Style x:Key="TextBlockHeadlineMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyHeader}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextBlockTitleSm" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextBlockBodyMd" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="TextBlockLabelXs" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="50" /> <!-- 0.05em -->
    </Style>

    <Style x:Key="TextBlockMonoStats" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

</ResourceDictionary>
